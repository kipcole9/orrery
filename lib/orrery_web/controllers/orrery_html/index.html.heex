<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2032%2032%22%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%2215%22%20fill=%22#0d0d0d%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%2211%22%20fill=%22none%22%20stroke=%22#898781%22%20stroke-width=%221.2%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%226.5%22%20fill=%22none%22%20stroke=%22#898781%22%20stroke-width=%221.2%22/%3E%3Ccircle%20cx=%2216%22%20cy=%2216%22%20r=%222.2%22%20fill=%22#fab219%22/%3E%3Ccircle%20cx=%2222.5%22%20cy=%2216%22%20r=%221.7%22%20fill=%22#2a78d6%22/%3E%3Ccircle%20cx=%228.2%22%20cy=%228.2%22%20r=%221.7%22%20fill=%22#0ca30c%22/%3E%3C/svg%3E"
    />
    <meta :if={@csrf_token} name="csrf-token" content={@csrf_token} />
    <title>Orrery</title>
    <style>
      :root {
        color-scheme: light;
        --plane:        #f9f9f7;
        --surface:      #fcfcfb;
        --surface-2:    #f2f1ed;
        --ink:          #0b0b0b;
        --ink-2:        #52514e;
        --muted:        #898781;
        --grid:         #e1e0d9;
        --baseline:     #c3c2b7;
        --border:       rgba(11,11,11,.10);
        --shadow:       0 1px 2px rgba(11,11,11,.05), 0 1px 12px rgba(11,11,11,.04);

        --good:         #0ca30c;
        --warning:      #fab219;
        --serious:      #ec835a;
        --critical:     #d03b3b;
        --progress:     #2a78d6;
        --neutral:      #898781;

        --radius:       10px;
        --radius-sm:    6px;
        --font:         system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono:         ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --plane:     #0d0d0d;
          --surface:   #1a1a19;
          --surface-2: #232322;
          --ink:       #ffffff;
          --ink-2:     #c3c2b7;
          --muted:     #898781;
          --grid:      #2c2c2a;
          --baseline:  #383835;
          --border:    rgba(255,255,255,.10);
          --shadow:    0 1px 2px rgba(0,0,0,.4), 0 1px 12px rgba(0,0,0,.25);
          --progress:  #3987e5;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --plane:     #0d0d0d;
        --surface:   #1a1a19;
        --surface-2: #232322;
        --ink:       #ffffff;
        --ink-2:     #c3c2b7;
        --muted:     #898781;
        --grid:      #2c2c2a;
        --baseline:  #383835;
        --border:    rgba(255,255,255,.10);
        --shadow:    0 1px 2px rgba(0,0,0,.4), 0 1px 12px rgba(0,0,0,.25);
        --progress:  #3987e5;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--plane);
        color: var(--ink);
        font-family: var(--font);
        font-size: 14px;
        line-height: 1.5;
      }
      a { color: inherit; }
      button { font: inherit; color: inherit; }

      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px 72px; }

      /* ---------- header ---------- */
      header {
        position: sticky; top: 0; z-index: 20;
        background: color-mix(in srgb, var(--plane) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }
      .head-inner {
        max-width: 1240px; margin: 0 auto; padding: 14px 16px;
        display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap;
      }
      h1 { font-size: 17px; font-weight: 640; margin: 0; letter-spacing: -.01em; }
      .subtitle { color: var(--muted); font-size: 12px; margin-top: 2px; }
      .subtitle code { font-family: var(--mono); font-size: 11.5px; }
      .head-actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }

      .ghost {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 6px 10px; cursor: pointer;
        font-size: 12.5px; color: var(--ink-2); white-space: nowrap;
      }
      .ghost:hover { background: var(--surface-2); color: var(--ink); }
      .ghost[aria-pressed="true"] { background: var(--surface-2); color: var(--ink); border-color: var(--baseline); }

      /* ---------- toolbar ---------- */
      .toolbar {
        display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
        padding: 18px 0 14px;
      }
      .search {
        flex: 1 1 260px; min-width: 200px;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 7px 11px; font-size: 13px;
        color: var(--ink);
      }
      .search::placeholder { color: var(--muted); }
      .search:focus { outline: 2px solid var(--progress); outline-offset: -1px; }
      .chips { display: flex; gap: 6px; flex-wrap: wrap; }
      .chip {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 999px; padding: 5px 11px; font-size: 12.5px;
        cursor: pointer; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px;
      }
      .chip:hover { background: var(--surface-2); }
      .chip[aria-pressed="true"] { background: var(--ink); color: var(--plane); border-color: var(--ink); }
      .chip .n { font-variant-numeric: tabular-nums; opacity: .7; }

      /* ---------- stat tiles ---------- */
      .tiles {
        display: grid; gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
        margin-bottom: 22px;
      }
      .tile {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 13px 14px; box-shadow: var(--shadow);
      }
      .tile .label { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
      .tile .value { font-size: 27px; font-weight: 600; letter-spacing: -.02em; margin-top: 3px; line-height: 1.1; }
      .tile .note { font-size: 12px; color: var(--ink-2); margin-top: 3px; }
      .tile .note b { font-weight: 600; }

      /* ---------- panels ---------- */
      section.panel {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 18px;
        overflow: hidden;
      }
      .panel-head {
        display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
        padding: 14px 16px 12px; border-bottom: 1px solid var(--border);
      }
      .panel-head h2 { font-size: 14px; font-weight: 620; margin: 0; letter-spacing: -.005em; }
      .panel-head .blurb { font-size: 12.5px; color: var(--muted); }
      .panel-head .right { margin-left: auto; display: flex; align-items: center; gap: 10px; }

      /* ---------- release bar ---------- */
      .releasebar { display: flex; gap: 2px; height: 22px; width: 100%; }
      .releasebar > div {
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 600; color: #fff;
        min-width: 2px; overflow: hidden; white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .releasebar > div:first-child { border-radius: 4px 0 0 4px; }
      .releasebar > div:last-child { border-radius: 0 4px 4px 0; }
      .releasebar > div:only-child { border-radius: 4px; }
      .seg-released  { background: var(--good); }
      .seg-unreleased_work { background: var(--progress); }
      .seg-pending   { background: var(--warning); color: #221a00; }
      .seg-untagged  { background: var(--neutral); }

      .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--ink-2); }
      .legend span { display: inline-flex; align-items: center; gap: 6px; }
      .swatch { width: 10px; height: 10px; border-radius: 3px; flex: none; }

      /* ---------- repo tables ---------- */
      .table-wrap { overflow-x: auto; }
      table.repos { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.repos th {
        font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
        color: var(--muted); text-align: left; padding: 7px 10px;
        border-bottom: 1px solid var(--border); white-space: nowrap;
      }
      table.repos td { padding: 8px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; vertical-align: middle; }
      table.repos th:first-child, table.repos td:first-child { padding-left: 16px; }
      table.repos th:last-child, table.repos td:last-child { padding-right: 16px; }
      table.repos tbody tr:last-child td { border-bottom: 0; }
      table.repos tr.repo-row { cursor: pointer; user-select: none; }
      table.repos tr.repo-row:hover td { background: var(--surface-2); }
      table.repos tr.repo-row:focus-visible { outline: 2px solid var(--progress); outline-offset: -2px; }
      table.repos .c-name { max-width: 0; width: 100%; font-weight: 570; }
      table.repos .c-name .nm { overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
      table.repos .c-name .chev { width: 12px; height: 12px; opacity: .45; margin-right: 6px; transition: transform .12s; vertical-align: middle; }
      table.repos .c-name .tag { margin-left: 6px; font-weight: 500; }
      table.repos .c-name .tag-blocked { color: var(--warning); border-color: color-mix(in srgb, var(--warning) 40%, transparent); }
      table.repos .c-ver { font-family: var(--mono); font-size: 12px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
      table.repos .c-ver .tag { margin-left: 5px; font-family: var(--font); }
      table.repos .num { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }
      table.repos .zero { color: var(--muted); }
      table.repos .count { display: inline-flex; align-items: center; gap: 5px; color: inherit; text-decoration: none; }
      table.repos .count svg { width: 12px; height: 12px; opacity: .65; }
      table.repos a.count:hover { color: var(--ink); text-decoration: underline; }
      table.repos .c-commit { color: var(--muted); font-size: 12.5px; }
      table.repos tr.repo-detail td { padding: 0 16px 14px; white-space: normal; background: var(--surface); }
      table.repos .c-group { color: var(--muted); font-size: 12.5px; }
      table.repos .ci { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 550; text-decoration: none; white-space: nowrap; }
      table.repos .ci svg { width: 11px; height: 11px; }
      table.repos .ci:hover { text-decoration: underline; }
      table.repos .ci-pass { color: var(--good); }
      table.repos .ci-fail { color: var(--critical); }
      table.repos .ci-running { color: var(--progress); }
      table.repos .ci-other { color: var(--muted); }
      table.repos .c-pull { white-space: nowrap; }
      table.repos .c-act { width: 1%; text-align: right; }
      .rowbtn {
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
        color: var(--ink-2); font: inherit; font-size: 13px; line-height: 1; padding: 3px 7px; cursor: pointer;
      }
      .rowbtn:hover { background: var(--surface-2); color: var(--ink); }
      .rowbtn:disabled { cursor: progress; opacity: .6; }
      /* In "Needs attention" the flags take the room and the name stays tight. */
      table.repos .c-proj { font-weight: 570; white-space: nowrap; }
      table.repos .c-msgs { white-space: normal; font-size: 12.5px; color: var(--ink-2); width: 100%; min-width: 280px; }
      table.repos .c-msgs .msg { display: flex; align-items: flex-start; gap: 5px; }
      table.repos .c-msgs .msg + .msg { margin-top: 3px; }
      table.repos .c-msgs svg { margin-top: 3px; }

      .pill {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11.5px; font-weight: 550; padding: 2px 8px 2px 6px;
        border-radius: 999px; white-space: nowrap;
        border: 1px solid transparent;
      }
      .pill svg { width: 11px; height: 11px; flex: none; }
      .p-released  { color: var(--good);     background: color-mix(in srgb, var(--good) 12%, transparent);     border-color: color-mix(in srgb, var(--good) 28%, transparent); }
      .p-unreleased_work { color: var(--progress); background: color-mix(in srgb, var(--progress) 12%, transparent); border-color: color-mix(in srgb, var(--progress) 28%, transparent); }
      .p-pending_release, .p-retagged { color: var(--warning); background: color-mix(in srgb, var(--warning) 16%, transparent); border-color: color-mix(in srgb, var(--warning) 34%, transparent); }
      .p-untagged  { color: var(--muted);    background: color-mix(in srgb, var(--muted) 14%, transparent);    border-color: color-mix(in srgb, var(--muted) 28%, transparent); }
      /* On the light surface the warning step is sub-3:1, so the pill text uses a
         darker step of the same hue. The icon and label carry the meaning either way. */
      :root:not([data-theme="dark"]) .p-pending_release,
      :root:not([data-theme="dark"]) .p-retagged { color: #8a6200; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .p-pending_release,
        :root:not([data-theme="light"]) .p-retagged { color: var(--warning); }
      }
      :root[data-theme="dark"] .p-pending_release,
      :root[data-theme="dark"] .p-retagged { color: var(--warning); }

      /* Sprite icons inherit their box from here unless a rule below is more
         specific; without it an unsized <svg> expands to its 300px default. */
      .wrap svg, .attn-msgs svg, .warnflag svg { width: 12px; height: 12px; flex: none; }

      .warnflag { display: inline-flex; align-items: center; gap: 4px; color: var(--warning); font-size: 12px; font-weight: 600; }
      :root:not([data-theme="dark"]) .warnflag { color: #9a6a00; }

      /* ---------- meters ---------- */
      .meter { display: flex; gap: 2px; height: 6px; border-radius: 3px; overflow: hidden; min-width: 54px; }
      .meter > i { display: block; }
      .m-done { background: var(--good); }
      .m-partial { background: var(--warning); }
      .m-open { background: var(--progress); }
      .m-blocked { background: var(--critical); }
      .m-empty { background: var(--grid); flex: 1; }

      /* ---------- detail ---------- */
      .detail { padding: 4px 16px 18px; background: var(--surface-2); border-top: 1px solid var(--border); }
      .detail-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
      .detail h3 {
        font-size: 11.5px; font-weight: 640; text-transform: uppercase; letter-spacing: .05em;
        color: var(--muted); margin: 16px 0 8px;
      }
      .kv { display: grid; grid-template-columns: auto 1fr; gap: 3px 14px; font-size: 12.5px; }
      .kv dt { color: var(--muted); }
      .kv dd { margin: 0; color: var(--ink-2); font-variant-numeric: tabular-nums; }
      .kv dd code, .mono { font-family: var(--mono); font-size: 12px; }

      ul.items { list-style: none; margin: 0; padding: 0; font-size: 12.5px; }
      ul.items li { display: flex; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
      ul.items li:last-child { border-bottom: 0; }
      ul.items .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; margin-top: 6px; }
      .d-done { background: var(--good); } .d-partial { background: var(--warning); }
      .d-open { background: var(--progress); } .d-blocked { background: var(--critical); }
      ul.items .txt { flex: 1; min-width: 0; color: var(--ink-2); }
      ul.items .meta { color: var(--muted); font-size: 11.5px; white-space: nowrap; font-variant-numeric: tabular-nums; }
      ul.items .ref { font-family: var(--mono); font-size: 11.5px; color: var(--muted); flex: none; }

      .plandoc { margin-bottom: 12px; }
      .plandoc .top { display: flex; align-items: center; gap: 10px; font-size: 12.5px; }
      .plandoc .top .t { font-weight: 560; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .plandoc .top .pct { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 11.5px; }
      .plandoc .status { font-size: 12px; color: var(--muted); margin-top: 4px; font-style: italic; }
      .plandoc .meter { margin-top: 5px; height: 5px; }
      .tag {
        display: inline-block; font-size: 10.5px; padding: 1px 6px; border-radius: 4px;
        background: var(--grid); color: var(--ink-2); white-space: nowrap;
      }

      .flags { display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; }
      .flags div { display: flex; gap: 7px; align-items: baseline; color: var(--ink-2); }
      .flags .cat { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; min-width: 82px; }
      .flags .warn .msg { color: var(--ink); font-weight: 540; }

      /* ---------- attention ---------- */

      .empty { padding: 26px 16px; color: var(--muted); font-size: 13px; text-align: center; }
      .hidden { display: none !important; }

      table.dt { width: 100%; border-collapse: collapse; font-size: 12.5px; }
      table.dt th, table.dt td { text-align: left; padding: 6px 16px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
      table.dt th { color: var(--muted); font-weight: 560; font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; }
      table.dt td:not(:first-child), table.dt th:not(:first-child) { text-align: right; }

      footer { color: var(--muted); font-size: 12px; padding: 8px 0 0; }
      footer a { color: var(--ink-2); }
    </style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-check" viewBox="0 0 16 16">
        <path
          d="M3 8.5l3.2 3.2L13 5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
      <symbol id="i-arrow" viewBox="0 0 16 16">
        <path
          d="M8 13V3M8 3L4 7M8 3l4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
      <symbol id="i-tag" viewBox="0 0 16 16">
        <path
          d="M2 2h5.5L14 8.5 8.5 14 2 7.5V2z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        /><circle cx="5" cy="5" r="1.2" fill="currentColor" />
      </symbol>
      <symbol id="i-dash" viewBox="0 0 16 16">
        <path
          d="M3.5 8h9"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </symbol>
      <symbol id="i-alert" viewBox="0 0 16 16">
        <path
          d="M8 2.2l6 11.1H2L8 2.2z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        /><path d="M8 6.4v3.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><circle
          cx="8"
          cy="11.4"
          r=".95"
          fill="currentColor"
        />
      </symbol>
      <symbol id="i-issue" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.7" /><circle
          cx="8"
          cy="8"
          r="1.7"
          fill="currentColor"
        />
      </symbol>
      <symbol id="i-pr" viewBox="0 0 16 16">
        <circle cx="4" cy="3.6" r="1.9" fill="none" stroke="currentColor" stroke-width="1.6" /><circle
          cx="4"
          cy="12.4"
          r="1.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        /><circle cx="12" cy="12.4" r="1.9" fill="none" stroke="currentColor" stroke-width="1.6" /><path
          d="M4 5.5v5M12 10.5V7.4a2 2 0 0 0-2-2H6.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </symbol>
      <symbol id="i-plan" viewBox="0 0 16 16">
        <rect
          x="3"
          y="2.2"
          width="10"
          height="11.6"
          rx="1.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        /><path
          d="M5.8 6h4.4M5.8 9h4.4M5.8 11.6h2.6"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </symbol>
      <symbol id="i-commit" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="2.9" fill="none" stroke="currentColor" stroke-width="1.7" /><path
          d="M1.6 8h3.5M10.9 8h3.5"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
      </symbol>
      <symbol id="i-chev" viewBox="0 0 16 16">
        <path
          d="M6 4l4 4-4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </symbol>
    </svg>

    <header>
      <div class="head-inner">
        <div>
          <h1 id="title">Orrery</h1>
          <div class="subtitle" id="subtitle"></div>
        </div>
        <div class="head-actions">
          <button
            :if={@mode == :server}
            class="ghost"
            id="refresh"
            title="Collect everything again now"
          >
            Refresh
          </button>
          <button
            class="ghost"
            id="tableToggle"
            aria-pressed="false"
            title="Show the release mix as a table as well as a bar"
          >
            Table view
          </button>
          <button class="ghost" id="expandAll" aria-pressed="false">Expand all</button>
          <button class="ghost" id="themeToggle" title="Switch between automatic, light and dark">
            Theme: auto
          </button>
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="toolbar">
        <input
          class="search"
          id="search"
          type="search"
          placeholder="Filter by project, group, issue or plan item…"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="chips" id="chips"></div>
      </div>

      <div class="tiles" id="tiles"></div>

      <section class="panel" id="attention">
        <div class="panel-head">
          <h2>Needs attention</h2>
          <span class="blurb">Unreleased versions, unanswered issues and unpushed work</span>
          <div class="right"><span class="blurb" id="attnCount"></span></div>
        </div>
        <div id="attnBody"></div>
      </section>

      <section class="panel" id="upcoming">
        <div class="panel-head">
          <h2>Upcoming</h2>
          <span class="blurb">What each blocker unblocks, soonest first</span>
          <div class="right"><span class="blurb" id="upcomingCount"></span></div>
        </div>
        <div id="upcomingBody"></div>
      </section>

      <div id="groups"></div>

      <footer id="footer"></footer>
    </div>

    <script>
      const DATA = <%= raw(script_safe(@data)) %>;
      const STATUS = <%= raw(script_json(@status)) %>;

      /* ------------------------------------------------------------------ */
      /* helpers                                                             */
      /* ------------------------------------------------------------------ */

      const $ = (s, r = document) => r.querySelector(s);
      const el = (tag, attrs = {}, kids = []) => {
        const n = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs)) {
          if (v === null || v === undefined || v === false) continue;
          if (k === "class") n.className = v;
          else if (k === "text") n.textContent = v;
          else if (k === "html") n.innerHTML = v;
          else n.setAttribute(k, v);
        }
        for (const kid of [].concat(kids)) if (kid) n.append(kid);
        return n;
      };
      const icon = (name, cls) => {
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        if (cls) svg.setAttribute("class", cls);
        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute("width", "12");
        svg.setAttribute("height", "12");
        const use = document.createElementNS("http://www.w3.org/2000/svg", "use");
        use.setAttribute("href", "#i-" + name);
        svg.append(use);
        return svg;
      };
      const plural = (n, one, many) => `${n} ${n === 1 ? one : (many || one + "s")}`;

      function daysAgo(iso) {
        if (!iso) return null;
        const then = Date.parse(iso);
        if (Number.isNaN(then)) return null;
        return Math.max(0, Math.floor((Date.now() - then) / 86400000));
      }
      function ago(iso) {
        const d = daysAgo(iso);
        if (d === null) return "—";
        if (d === 0) return "today";
        if (d === 1) return "yesterday";
        if (d < 31) return `${d} days ago`;
        if (d < 365) return `${Math.round(d / 30.4)} months ago`;
        const y = d / 365;
        return `${y.toFixed(y < 10 ? 1 : 0)} years ago`;
      }
      function shortDate(iso) { return iso ? iso.slice(0, 10) : "—"; }

      /* Release states, in the order they appear in the stacked bar. */
      const STATES = [
        { key: "released",        label: "Current",         cls: "seg-released",        icon: "check", color: "var(--good)" },
        { key: "unreleased_work", label: "Unreleased work",  cls: "seg-unreleased_work", icon: "arrow", color: "var(--progress)" },
        { key: "pending_release", label: "Awaiting a tag",   cls: "seg-pending",         icon: "tag",   color: "var(--warning)" },
        { key: "untagged",        label: "Never released",   cls: "seg-untagged",        icon: "dash",  color: "var(--neutral)" }
      ];
      const STATE_LABEL = {
        released: "Current", unreleased_work: "Unreleased work",
        pending_release: "Awaiting a tag", retagged: "Ahead of mix.exs", untagged: "Never released"
      };
      const STATE_ICON = {
        released: "check", unreleased_work: "arrow",
        pending_release: "tag", retagged: "alert", untagged: "dash"
      };
      // `retagged` is rare; it shares the warning bucket with `pending_release`.
      const bucket = s => (s === "retagged" ? "pending_release" : s);

      /* ------------------------------------------------------------------ */
      /* flatten                                                             */
      /* ------------------------------------------------------------------ */

      const repos = [];
      for (const g of DATA.groups) for (const r of g.repos) {
        r._group = g;
        r._warnings = (r.flags || []).filter(f => f.severity === "warn");
        r._issues = r.issue_summary || { open: 0, prs: 0, unanswered: 0, stale: 0, draft_prs: 0 };
        r._plans = r.plan_summary || { open: 0, documents: 0, items: 0 };
        r._score =
          r._warnings.length * 100 +
          (r._issues.unanswered || 0) * 20 +
          (r._issues.prs - (r._issues.draft_prs || 0)) * 15 +
          (r._plans.open || 0) +
          (r.changelog && r.changelog.unreleased ? 10 : 0);
        r._haystack = [
          r.name, r.group, r.path, r.app, r.version,
          r.github && r.github.description,
          ...(r.flags || []).map(f => f.message),
          ...((r.github && r.github.issues) || []).map(i => i.title),
          ...((r.github && r.github.prs) || []).map(i => i.title),
          ...(r.plans || []).flatMap(p => [p.title, p.file, ...(p.open_items || []).map(i => i.title)])
        ].filter(Boolean).join(" ").toLowerCase();
        repos.push(r);
      }

      /* ------------------------------------------------------------------ */
      /* filters                                                             */
      /* ------------------------------------------------------------------ */

      const FILTERS = [
        { key: "all",       label: "All",              test: () => true },
        { key: "attention", label: "Needs attention",  test: r => r._warnings.length > 0 },
        { key: "pending",   label: "Awaiting a tag",   test: r => bucket(r.release_state) === "pending_release" },
        { key: "unreleased",label: "Unreleased work",  test: r => r.release_state === "unreleased_work" },
        { key: "issues",    label: "Open issues",      test: r => r._issues.open > 0 },
        { key: "prs",       label: "Open PRs",         test: r => r._issues.prs > 0 },
        { key: "plans",     label: "Open plan items",  test: r => r._plans.open > 0 },
        { key: "active",    label: "Active",           test: r => !r.status || r.status.state === "active" || r.status.state === "application" },
        { key: "ci",        label: "CI failing",       test: r => !!(r.github && r.github.ci && r.github.ci.failed) },
        { key: "blocked",   label: "Blocked",          test: r => !!(r.blocked && r.blocked.active) }
      ];

      // Served by the application (the static file has no header button and
      // no server to ask), so row buttons and polling exist only then.
      const SERVED = !!$("#refresh");
      const csrf = SERVED ? $('meta[name="csrf-token"]')?.content : null;
      let polling = false;

      const state = { filter: "all", query: "", expanded: new Set(), tableView: false };

      // A refresh ends in a reload; keep what was open and filtered so the
      // page comes back as it was. Per-tab, best effort, never required.
      try {
        const saved = JSON.parse(sessionStorage.getItem("orrery-view") || "null");
        if (saved) {
          state.filter = saved.filter || "all";
          state.query = saved.query || "";
          state.tableView = !!saved.tableView;
          state.expanded = new Set(saved.expanded || []);
        }
      } catch (_error) { /* storage unavailable */ }
      function saveView() {
        try {
          sessionStorage.setItem("orrery-view", JSON.stringify({
            filter: state.filter, query: state.query, tableView: state.tableView, expanded: [...state.expanded]
          }));
        } catch (_error) { /* storage unavailable */ }
      }

      function visible() {
        const f = FILTERS.find(f => f.key === state.filter) || FILTERS[0];
        const q = state.query.trim().toLowerCase();
        return repos.filter(r => f.test(r) && (!q || r._haystack.includes(q)));
      }

      /* ------------------------------------------------------------------ */
      /* header, tiles, chips                                                */
      /* ------------------------------------------------------------------ */

      function renderHeader() {
        const gh = DATA.github || {};
        const bits = [
          `${DATA.totals.repos} repos in ${DATA.totals.groups} projects`,
          `<code>${DATA.root}</code>`,
          `collected ${ago(DATA.generated_at)}`
        ];
        if (!gh.enabled) bits.push("GitHub not queried");
        else if (gh.rate_limited) bits.push("GitHub rate limit reached — some counts are cached");
        else if (!gh.authenticated) bits.push("GitHub unauthenticated");
        $("#subtitle").innerHTML = bits.join(" · ");
        document.title = `Orrery — ${DATA.totals.repos} repos`;

        const parts = [`Generated ${DATA.generated_at} from ${DATA.root}.`];
        if (STATUS.next_refresh_at) parts.push(`Next automatic collection at ${new Date(STATUS.next_refresh_at).toLocaleString()}.`);
        if (gh.enabled && gh.remaining !== null && gh.remaining !== undefined) {
          parts.push(`GitHub: ${gh.calls} requests this run, ${gh.remaining} remaining in the window` +
            (gh.token_var ? ` (token from $${gh.token_var}).` : "."));
        }
        parts.push("Plan progress is read from plan documents; documents written as prose are listed but not counted.");
        $("#footer").textContent = parts.join(" ");
      }

      function renderTiles() {
        const s = DATA.summary;
        const tiles = [
          { label: "Repos", value: s.repos,
            note: `${s.commits_30d} commits in the last 30 days` },
          { label: "Releases current", value: s.released,
            note: `${s.unreleased_work} with unreleased work` },
          { label: "Awaiting a tag", value: s.pending_release,
            note: s.pending_release ? "version bumped, not yet tagged" : "nothing waiting" },
          { label: "Open issues", value: s.open_issues,
            note: `${s.unanswered_issues} with no reply · ${s.stale_issues} stale` },
          { label: "Open pull requests", value: s.open_prs,
            note: s.open_prs ? "awaiting review or merge" : "none outstanding" },
          { label: "Open plan items", value: s.plan_open,
            note: `of ${s.plan_items} tracked across ${s.plan_documents} documents` }
        ];
        $("#tiles").replaceChildren(...tiles.map(t =>
          el("div", { class: "tile" }, [
            el("div", { class: "label", text: t.label }),
            el("div", { class: "value", text: String(t.value) }),
            el("div", { class: "note", text: t.note })
          ])
        ));
      }

      function renderChips() {
        $("#chips").replaceChildren(...FILTERS.map(f => {
          const n = repos.filter(f.test).length;
          const b = el("button", { class: "chip", "aria-pressed": String(state.filter === f.key) }, [
            el("span", { text: f.label }),
            f.key === "all" ? null : el("span", { class: "n", text: String(n) })
          ]);
          b.addEventListener("click", () => { state.filter = f.key; render(); });
          return b;
        }));
      }

      /* ------------------------------------------------------------------ */
      /* release bar                                                         */
      /* ------------------------------------------------------------------ */

      function releaseBar(list) {
        const counts = {};
        for (const st of STATES) counts[st.key] = 0;
        for (const r of list) counts[bucket(r.release_state)] = (counts[bucket(r.release_state)] || 0) + 1;

        const total = list.length || 1;
        const bar = el("div", { class: "releasebar", role: "img",
          "aria-label": STATES.map(s => `${counts[s.key]} ${s.label}`).join(", ") });

        for (const st of STATES) {
          const n = counts[st.key];
          if (!n) continue;
          const pct = (n / total) * 100;
          // Direct-label the segment when it is wide enough to hold the number.
          bar.append(el("div", {
            class: st.cls,
            style: `flex: 0 0 ${pct}%`,
            title: `${n} ${st.label}`,
            text: pct >= 9 ? String(n) : ""
          }));
        }
        return { bar, counts };
      }

      function releaseLegend(counts) {
        return el("div", { class: "legend" }, STATES.map(st =>
          el("span", { style: counts[st.key] ? null : "opacity:.45" }, [
            el("i", { class: "swatch", style: `background:${st.color}` }),
            el("span", { text: `${st.label} ${counts[st.key]}` })
          ])
        ));
      }

      function releaseTable(counts, total) {
        const t = el("table", { class: "dt" });
        t.append(el("thead", {}, el("tr", {}, [
          el("th", { text: "Release state" }), el("th", { text: "Repos" }), el("th", { text: "Share" })
        ])));
        const body = el("tbody");
        for (const st of STATES) {
          body.append(el("tr", {}, [
            el("td", { text: st.label }),
            el("td", { text: String(counts[st.key]) }),
            el("td", { text: total ? `${Math.round((counts[st.key] / total) * 100)}%` : "—" })
          ]));
        }
        t.append(body);
        return t;
      }

      /* ------------------------------------------------------------------ */
      /* repo row                                                            */
      /* ------------------------------------------------------------------ */

      function statePill(r) {
        const st = r.release_state || "untagged";
        return el("span", { class: `pill p-${st}`, title: releaseTitle(r) }, [
          icon(STATE_ICON[st] || "dash"),
          el("span", { text: STATE_LABEL[st] || st })
        ]);
      }

      function releaseTitle(r) {
        const g = r.git || {};
        switch (r.release_state) {
          case "released": return `v${r.version} tagged ${shortDate(g.last_tag_date)}, nothing since`;
          case "unreleased_work": return `${plural(g.commits_since_tag, "commit")} since ${g.last_tag}`;
          case "pending_release": return `mix.exs says v${r.version}; newest tag is ${g.last_tag}`;
          case "retagged": return `newest tag ${g.last_tag} is ahead of mix.exs v${r.version}`;
          default: return "no release tags in this repository";
        }
      }

      function meter(counts, total) {
        const m = el("div", { class: "meter" });
        if (!total) { m.append(el("i", { class: "m-empty" })); return m; }
        for (const [k, cls] of [["done", "m-done"], ["partial", "m-partial"], ["open", "m-open"], ["blocked", "m-blocked"]]) {
          const n = counts[k] || 0;
          if (n) m.append(el("i", { class: cls, style: `flex: 0 0 ${(n / total) * 100}%` }));
        }
        return m;
      }

      /* Each column is one entry: a header label, a class for its cells and a
         function rendering the cell. Adding a column means adding an entry. */
      const COLUMNS = [
        { label: "Repo", cls: "c-name", cell: r => [
            icon("chev", "chev"),
            el("span", { class: "nm", text: r.name }),
            // STATUS.md, when it says anything other than active.
            r.status && r.status.state !== "active"
              ? el("span", { class: "tag", text: r.status.label, title: r.status.note || "" })
              : null,
            // A release blocked on something, per STATUS.md's "Blocked on:" lines.
            r.blocked && r.blocked.active
              ? el("span", { class: "tag tag-blocked", text: "blocked", title: r.blocked.blockers.map(blockerLine).join("\n") })
              : null
          ] },
        { label: "Version", cls: "c-ver", cell: r => [
            el("span", { text: r.version ? "v" + r.version : "—" }),
            // Most of these are Elixir; name the language only when it isn't.
            r.kind && r.kind !== "elixir" ? el("span", { class: "tag", text: r.kind }) : null
          ] },
        { label: "Release", cls: "c-release", cell: r => statePill(r) },
        { label: "Hex", cls: "c-ver", cell: r => hexCell(r) },
        { label: "CI", cls: "c-ci", cell: r => ciCell(r) },
        { label: "Issues", cls: "num", cell: r => githubCount(r, "issues", r._issues.open, "open issue", "issue") },
        { label: "PRs", cls: "num", cell: r => githubCount(r, "pulls", r._issues.prs, "open pull request", "pr") },
        { label: "Plan items", cls: "num", cell: r =>
            el("span", { class: r._plans.open ? null : "zero", title: "Open plan items", text: String(r._plans.open) }) },
        { label: "Last commit", cls: "c-commit", cell: r => el("span", { text: ago((r.git || {}).head_date) }) },
        { label: "Needs pulling", cls: "c-pull", cell: r => pullCell(r) },
        { label: "Flags", cls: "num", cell: r => r._warnings.length
            ? el("span", { class: "warnflag", title: r._warnings.map(f => f.message).join("\n") },
                [icon("alert"), el("span", { text: String(r._warnings.length) })])
            : el("span", { class: "zero", text: "—" }) },
        { label: "", cls: "c-act", cell: r => rowRefreshButton(r) }
      ];

      function blockerLine(b) {
        const state = b.resolved === true ? "cleared" : (b.overdue ? "overdue" : "open");
        return `${b.text}${b.latest ? ` (hex has ${b.latest})` : ""}${b.expected ? `, expected ${b.expected}` : ""} \u2014 ${state}`;
      }

      // The newest workflow run on the default branch, linking to it.
      function ciCell(r) {
        const ci = r.github && r.github.ci;
        if (!ci) return el("span", { class: "zero", text: "\u2014", title: r.github ? "no workflow runs" : "GitHub not queried" });
        const running = ci.status !== "completed";
        const kind = running ? "running" : (ci.failed ? "fail" : (ci.conclusion === "success" ? "pass" : "other"));
        const label = running ? "running" : (ci.conclusion || ci.status);
        const a = el("a", { class: "ci ci-" + kind, href: ci.url, target: "_blank", rel: "noopener",
          title: `${ci.workflow}: ${label} on ${ci.branch} at ${ci.sha} (${ago(ci.updated_at)}) \u2014 open on GitHub` },
          [icon(kind === "pass" ? "check" : kind === "fail" ? "alert" : "dash"), el("span", { text: label })]);
        a.addEventListener("click", e => e.stopPropagation());
        return a;
      }

      // The version hex.pm has, linking to the package page; a dash when the
      // package is not published or hex was not asked.
      function hexCell(r) {
        if (!r.hex || !r.hex.published) {
          return el("span", { class: "zero", text: "\u2014", title: r.hex ? "not published on hex" : (r.hex_error || "hex not queried") });
        }
        const a = el("a", { class: "count", href: r.hex.url, target: "_blank", rel: "noopener",
          title: `v${r.hex.latest} published ${shortDate(r.hex.latest_at)} (${ago(r.hex.latest_at)}) \u2014 open on hex.pm`,
          text: "v" + r.hex.latest });
        a.addEventListener("click", e => e.stopPropagation());
        return a;
      }

      // A count that links to the matching GitHub page in a new tab. The row
      // around it toggles the detail, so the click must not bubble.
      function githubCount(r, page, n, noun, iconName) {
        const href = r.repo_url ? `${r.repo_url}/${page}` : null;
        const attrs = { class: "count" + (n ? "" : " zero"), title: plural(n, noun) + (href ? " — open on GitHub" : "") };
        if (href) Object.assign(attrs, { href, target: "_blank", rel: "noopener" });
        const node = el(href ? "a" : "span", attrs, [icon(iconName), el("span", { text: String(n) })]);
        if (href) node.addEventListener("click", e => e.stopPropagation());
        return node;
      }

      // Whether the clone needs pulling, in a word; the full reason is the tooltip.
      function pullLabel(pull) {
        if (pull.remote_behind) return "yes";
        if (pull.behind_upstream) return `${pull.behind_upstream} behind`;
        return "hex is ahead";
      }

      function pullCell(r) {
        if (r.pull && r.pull.needed) {
          return el("span", { class: "warnflag", title: r.pull.reason }, [icon("arrow"), el("span", { text: pullLabel(r.pull) })]);
        }
        return el("span", { class: "zero", text: "\u2014",
          title: r.pull && r.pull.remote_checked ? "up to date with origin" : "origin not asked" });
      }

      // "Refresh this one": collects just that repository again.
      function rowRefreshButton(r) {
        if (!SERVED) return null;
        const b = el("button", { class: "rowbtn", type: "button", title: `Collect ${r.name} again now`, text: "\u21bb" });
        b.addEventListener("click", e => {
          e.stopPropagation();
          b.disabled = true; b.textContent = "\u2026";
          requestRefresh({ repo: r.path });
        });
        return b;
      }

      function repoTable(list) {
        const head = el("thead", {}, el("tr", {}, COLUMNS.map(c => el("th", { class: c.cls, text: c.label }))));
        const body = el("tbody");

        for (const r of list) {
          const open = state.expanded.has(r.path);
          const toggle = () => {
            if (state.expanded.has(r.path)) state.expanded.delete(r.path);
            else state.expanded.add(r.path);
            render();
          };

          const row = el("tr", {
            class: "repo-row", role: "button", tabindex: "0",
            "aria-expanded": String(open), "aria-controls": `d-${cssId(r.path)}`
          }, COLUMNS.map(c => el("td", { class: c.cls }, c.cell(r))));
          row.querySelector(".chev").style.transform = open ? "rotate(90deg)" : "";
          row.addEventListener("click", toggle);
          row.addEventListener("keydown", e => {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); }
          });
          body.append(row);

          if (open) {
            body.append(el("tr", { class: "repo-detail" },
              el("td", { colspan: String(COLUMNS.length) }, repoDetail(r))));
          }
        }

        return el("div", { class: "table-wrap" }, el("table", { class: "repos" }, [head, body]));
      }

      const cssId = p => p.replace(/[^a-z0-9]+/gi, "-");

      /* ------------------------------------------------------------------ */
      /* repo detail                                                         */
      /* ------------------------------------------------------------------ */

      function repoDetail(r) {
        const g = r.git || {};
        const gh = r.github;
        const cl = r.changelog;

        const release = el("div", {}, [
          el("h3", { text: "Release" }),
          (() => {
            const kv = el("dl", { class: "kv" });
            const rows = [
              ["mix.exs", r.version ? "v" + r.version : "no version found"],
              ["Newest tag", g.last_tag ? `${g.last_tag} · ${shortDate(g.last_tag_date)} (${ago(g.last_tag_date)})` : "none"],
              ["CI", r.github && r.github.ci
                ? `${r.github.ci.workflow}: ${r.github.ci.status === "completed" ? r.github.ci.conclusion : r.github.ci.status} on ${r.github.ci.branch} at ${r.github.ci.sha} (${ago(r.github.ci.updated_at)})`
                : (r.github ? "no workflow runs" : "not queried")],
              ["Blocked on", r.blocked && r.blocked.blockers.length ? r.blocked.blockers.map(blockerLine).join("; ") : "nothing"],
              ["On hex", r.hex
                ? (r.hex.published ? `v${r.hex.latest} · ${shortDate(r.hex.latest_at)} (${ago(r.hex.latest_at)}) · ${plural(r.hex.releases, "release")}` : "not published")
                : (r.hex_error || "not queried")],
              ["Since that tag", g.last_tag ? plural(g.commits_since_tag || 0, "commit") : "—"],
              ["Changelog", cl ? (cl.latest_version ? `v${cl.latest_version} · ${cl.latest_date || "undated"}` : "no version heading") : "none found"],
              ["Branch", g.branch + (g.default_branch && g.branch !== g.default_branch ? ` (default is ${g.default_branch})` : "")],
              ["Working tree", g.dirty_files ? plural(g.dirty_files, "uncommitted file") : "clean"],
              ["Unpushed", g.unpushed === null || g.unpushed === undefined ? "no upstream branch" : plural(g.unpushed, "commit")],
              ["Last commit", `${ago(g.head_date)} · ${g.head_sha || ""}`],
              ["Activity", `${g.commits_30d || 0} in 30 days, ${g.commits_90d || 0} in 90`],
              ["Tags", String(g.tag_count || 0)]
            ];
            for (const [k, v] of rows) { kv.append(el("dt", { text: k }), el("dd", { text: v })); }
            return kv;
          })(),
          cl && cl.unreleased
            ? el("div", {}, [
                el("h3", { text: `Waiting in the changelog — ${plural(cl.unreleased_entries, "entry", "entries")}` }),
                cl.unreleased_categories.length
                  ? el("div", { style: "margin-bottom:6px" }, cl.unreleased_categories.map(c =>
                      el("span", { class: "tag", text: c, style: "margin-right:4px" })))
                  : null,
                el("ul", { class: "items" }, cl.unreleased_preview.map(p =>
                  el("li", {}, [el("i", { class: "dot d-open" }), el("span", { class: "txt", text: p })])))
              ])
            : null
        ]);

        const issues = el("div", {}, [
          el("h3", { text: "Issues and pull requests" }),
          r.github_error
            ? el("div", { class: "flags" }, el("div", { class: "warn" }, [
                el("span", { class: "cat", text: "unavailable" }),
                el("span", { class: "msg", text: r.github_error })
              ]))
            : !gh
              ? el("div", { style: "color:var(--muted);font-size:12.5px", text: "GitHub was not queried for this run." })
              : el("div", {}, [
                  (() => {
                    const s = r._issues, kv = el("dl", { class: "kv" });
                    const rows = [
                      ["Open issues", String(s.open)],
                      ["Open pull requests", s.prs + (s.draft_prs ? ` (${s.draft_prs} draft)` : "")],
                      ["No reply yet", String(s.unanswered)],
                      ["Untouched 180+ days", String(s.stale)],
                      ["Opened in 30 days", String(s.fresh_30d)],
                      ["Median age", s.median_age_days === null ? "—" : plural(s.median_age_days, "day")],
                      ["Oldest", s.oldest_days === null ? "—" : plural(s.oldest_days, "day")],
                      ["Stars", String(gh.stars ?? "—")]
                    ];
                    for (const [k, v] of rows) { kv.append(el("dt", { text: k }), el("dd", { text: v })); }
                    return kv;
                  })(),
                  r._issues.labels && r._issues.labels.length
                    ? el("div", { style: "margin-top:8px" }, r._issues.labels.map(l =>
                        el("span", { class: "tag", text: `${l.name} ${l.count}`, style: "margin:0 4px 4px 0" })))
                    : null,
                  issueList("Open issues", gh.issues, r),
                  issueList("Open pull requests", gh.prs, r)
                ])
        ]);

        const plans = el("div", {}, [
          el("h3", { text: "Plan documents" }),
          (r.plans || []).length === 0
            ? el("div", { style: "color:var(--muted);font-size:12.5px", text: "No plan documents in this repository." })
            : el("div", {}, r.plans.map(p => planDoc(p, r)))
        ]);

        const flags = (r.flags || []).length
          ? el("div", {}, [
              el("h3", { text: "Signals" }),
              el("div", { class: "flags" }, r.flags.map(f =>
                el("div", { class: f.severity === "warn" ? "warn" : "" }, [
                  el("span", { class: "cat", text: f.category }),
                  el("span", { class: "msg", text: f.message })
                ])))
            ])
          : null;

        const links = el("div", { style: "margin-top:14px;font-size:12.5px;color:var(--muted)" }, [
          el("span", { class: "mono", text: r.path }),
          r.repo_url ? el("span", { text: " · " }) : null,
          r.repo_url ? el("a", { href: r.repo_url, target: "_blank", rel: "noreferrer", text: r.repo_url.replace("https://github.com/", "") }) : null,
          gh && gh.description ? el("div", { style: "margin-top:4px", text: gh.description }) : null
        ]);

        return el("div", { class: "detail", id: `d-${cssId(r.path)}` }, [
          el("div", { class: "detail-grid" }, [release, issues, plans]),
          flags,
          links
        ]);
      }

      function issueList(heading, list, r) {
        if (!list || !list.length) return null;
        return el("div", {}, [
          el("h3", { text: heading, style: "margin-top:14px" }),
          el("ul", { class: "items" }, list.slice(0, 12).map(i => {
            const age = daysAgo(i.created_at);
            const quiet = daysAgo(i.updated_at);
            const cls = i.comments === 0 ? "d-blocked" : (quiet > 180 ? "d-partial" : "d-open");
            return el("li", {}, [
              el("i", { class: "dot " + cls, title: i.comments === 0 ? "no reply yet" : `${i.comments} comments` }),
              el("span", { class: "ref", text: "#" + i.number }),
              el("span", { class: "txt" }, [
                i.url ? el("a", { href: i.url, target: "_blank", rel: "noreferrer", text: i.title, style: "text-decoration:none" })
                      : el("span", { text: i.title }),
                (i.labels || []).length ? el("span", { text: " " }) : null,
                ...(i.labels || []).map(l => el("span", { class: "tag", text: l, style: "margin-left:4px" }))
              ]),
              el("span", { class: "meta", text: `${age}d · ${plural(i.comments, "reply", "replies")}` })
            ]);
          }))
        ]);
      }

      function planDoc(p, r) {
        const counts = { done: p.done, partial: p.partial, blocked: p.blocked,
                         open: Math.max(0, p.open - p.partial - p.blocked) };
        const link = r.repo_url ? `${r.repo_url}/blob/${(r.git && r.git.default_branch) || "main"}/${p.file}` : null;

        return el("div", { class: "plandoc" }, [
          el("div", { class: "top" }, [
            el("span", { class: "t" }, [
              link ? el("a", { href: link, target: "_blank", rel: "noreferrer", text: p.title, style: "text-decoration:none" })
                   : el("span", { text: p.title })
            ]),
            p.tracked
              ? el("span", { class: "pct", text: `${p.open} open of ${p.total}${p.percent_done !== null ? ` · ${p.percent_done}%` : ""}` })
              : el("span", { class: "tag", text: "prose" })
          ]),
          p.tracked ? meter(counts, p.total) : null,
          p.status_line ? el("div", { class: "status", text: p.status_line }) : null,
          p.tracked && p.open_items.length
            ? el("ul", { class: "items", style: "margin-top:6px" }, p.open_items.slice(0, 8).map(i =>
                el("li", {}, [
                  el("i", { class: "dot d-" + i.state, title: i.state }),
                  i.ref ? el("span", { class: "ref", text: i.ref }) : null,
                  el("span", { class: "txt", text: i.title }),
                  i.state !== "open" ? el("span", { class: "meta", text: i.state }) : null
                ])))
            : null,
          p.tracked && p.open_items.length > 8
            ? el("div", { style: "font-size:11.5px;color:var(--muted);margin-top:3px",
                          text: `…and ${p.open - 8} more` })
            : null,
          !p.tracked && p.headings.length
            ? el("div", { class: "status", text: p.headings.slice(0, 6).join(" · ") })
            : null,
          el("div", { style: "font-size:11.5px;color:var(--muted);margin-top:3px" }, [
            el("span", { class: "mono", text: p.file }),
            el("span", { text: ` · ${p.words.toLocaleString()} words · updated ${ago(p.modified)}` })
          ])
        ]);
      }

      /* ------------------------------------------------------------------ */
      /* attention panel                                                     */
      /* ------------------------------------------------------------------ */

      function renderAttention(list) {
        const flagged = list.filter(r => r._warnings.length).sort((a, b) => b._score - a._score);
        $("#attnCount").textContent = flagged.length ? `${flagged.length} of ${list.length} shown` : "";

        if (!flagged.length) {
          $("#attnBody").replaceChildren(el("div", { class: "empty",
            text: list.length ? "Nothing flagged in the current selection." : "No repos match the current filter." }));
          return;
        }

        const ATTENTION = [
          { label: "Repo", cls: "c-proj", cell: r => el("span", { class: "nm", text: r.name }) },
          { label: "Project", cls: "c-group", cell: r => el("span", { text: r.group }) },
          { label: "Release", cls: "c-release", cell: r => statePill(r) },
          { label: "Needs pulling", cls: "c-pull", cell: r => pullCell(r) },
          { label: "Flags", cls: "c-msgs", cell: r => r._warnings.filter(f => !f.message.startsWith("needs pulling")).map(f =>
              el("div", { class: "msg" }, [icon("alert", "warnicon"), el("span", { text: f.message })])) },
          { label: "", cls: "c-act", cell: r => rowRefreshButton(r) }
        ];

        const head = el("thead", {}, el("tr", {}, ATTENTION.map(c => el("th", { class: c.cls, text: c.label }))));
        const body = el("tbody", {}, flagged.map(r => {
          // Clicking a flagged repo opens its detail in its project below.
          const row = el("tr", { class: "repo-row", role: "button", tabindex: "0", title: "Show in its project" },
            ATTENTION.map(c => el("td", { class: c.cls }, c.cell(r))));
          const reveal = () => {
            state.expanded.add(r.path);
            render();
            const detail = document.getElementById(`d-${cssId(r.path)}`);
            if (detail) detail.scrollIntoView({ block: "center", behavior: "smooth" });
          };
          row.addEventListener("click", reveal);
          row.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); reveal(); } });
          return row;
        }));
        $("#attnBody").replaceChildren(el("div", { class: "table-wrap" }, el("table", { class: "repos" }, [head, body])));
      }

      /* ------------------------------------------------------------------ */
      /* upcoming: the release pipeline implied by STATUS.md blockers        */
      /* ------------------------------------------------------------------ */

      // One row per distinct blocker, with the repos waiting on it. A blocker
      // that is one of our packages, itself blocked, shows what it waits for.
      function renderUpcoming(list) {
        const byBlocker = new Map();
        for (const r of list) {
          for (const b of (r.blocked ? r.blocked.blockers : [])) {
            const key = b.package ? `${b.package} ${b.requirement}` : b.text;
            if (!byBlocker.has(key)) byBlocker.set(key, { key, blocker: b, repos: [] });
            byBlocker.get(key).repos.push(r);
          }
        }
        const rows = [...byBlocker.values()].sort((a, b) =>
          (a.blocker.expected || "9999").localeCompare(b.blocker.expected || "9999") || a.key.localeCompare(b.key));

        $("#upcomingCount").textContent = rows.length ? plural(rows.length, "blocker") : "";
        if (!rows.length) {
          $("#upcomingBody").replaceChildren(el("div", { class: "empty", text: "Nothing is waiting on anything." }));
          return;
        }

        const upstreamOf = b => {
          if (!b.package) return null;
          const dep = repos.find(r => r.hex && r.hex.name === b.package) || repos.find(r => r.app === b.package);
          return dep && dep.blocked && dep.blocked.active ? dep.blocked.blockers.map(x => x.text).join(", ") : null;
        };
        const stateOf = b => b.resolved === true ? "cleared" : (b.overdue ? "overdue" : "waiting");

        const UPCOMING = [
          { label: "Expected", cls: "c-ver", cell: x => el("span", { text: x.blocker.expected || "\u2014" }) },
          { label: "Waiting on", cls: "c-proj", cell: x => [
              el("span", { text: x.blocker.text }),
              x.blocker.latest ? el("span", { class: "tag", text: `hex has ${x.blocker.latest}` }) : null
            ] },
          { label: "Which waits on", cls: "c-group", cell: x => el("span", { text: upstreamOf(x.blocker) || "\u2014" }) },
          // The release each repo is waiting to cut: STATUS.md's "Next release:"
          // when given, else the mix.exs version marked as the current one.
          { label: "Unblocks", cls: "c-msgs", cell: x => x.repos.map(r =>
              el("div", { class: "msg" }, [el("span", { text: r.next_release ? `${r.name} v${r.next_release}` : `${r.name} (now v${r.version || "?"})` })])) },
          { label: "State", cls: "c-pull", cell: x => {
              const st = stateOf(x.blocker);
              return el("span", { class: st === "waiting" ? "zero" : "warnflag", text: st });
            } }
        ];

        const head = el("thead", {}, el("tr", {}, UPCOMING.map(c => el("th", { class: c.cls, text: c.label }))));
        const body = el("tbody", {}, rows.map(x => el("tr", {}, UPCOMING.map(c => el("td", { class: c.cls }, c.cell(x))))));
        $("#upcomingBody").replaceChildren(el("div", { class: "table-wrap" }, el("table", { class: "repos" }, [head, body])));
      }

      /* ------------------------------------------------------------------ */
      /* groups                                                              */
      /* ------------------------------------------------------------------ */

      function renderGroups(list) {
        const byGroup = new Map();
        for (const r of list) {
          if (!byGroup.has(r.group)) byGroup.set(r.group, []);
          byGroup.get(r.group).push(r);
        }

        // Projects in alphabetical order, with "Other" — the repos that belong
        // to none — always last.
        const ordered = DATA.groups.slice().sort((a, b) =>
          (a.name === "Other") - (b.name === "Other") || a.name.localeCompare(b.name));

        const out = [];
        for (const g of ordered) {
          const members = byGroup.get(g.name);
          if (!members || !members.length) continue;

          const sorted = members.slice().sort((a, b) => b._score - a._score || a.name.localeCompare(b.name));
          const { bar, counts } = releaseBar(sorted);

          const panel = el("section", { class: "panel" }, [
            el("div", { class: "panel-head" }, [
              el("h2", { text: g.name }),
              el("span", { class: "blurb", text: g.blurb || "" }),
              el("div", { class: "right" }, [
                el("span", { class: "blurb", text: summaryLine(sorted) })
              ])
            ]),
            el("div", { style: "padding:12px 16px 10px;border-bottom:1px solid var(--border)" }, [
              bar,
              el("div", { style: "margin-top:8px" }, releaseLegend(counts)),
              state.tableView ? el("div", { style: "margin-top:10px" }, releaseTable(counts, sorted.length)) : null
            ]),
            repoTable(sorted)
          ]);
          out.push(panel);
        }

        $("#groups").replaceChildren(...(out.length ? out : [
          el("section", { class: "panel" }, el("div", { class: "empty", text: "No repos match the current filter." }))
        ]));
      }

      function summaryLine(list) {
        const issues = list.reduce((n, r) => n + r._issues.open, 0);
        const prs = list.reduce((n, r) => n + r._issues.prs, 0);
        const plans = list.reduce((n, r) => n + r._plans.open, 0);
        return `${plural(list.length, "repo")} · ${issues} issues · ${prs} PRs · ${plans} plan items`;
      }

      /* ------------------------------------------------------------------ */
      /* render + events                                                     */
      /* ------------------------------------------------------------------ */

      function render() {
        saveView();
        const list = visible();
        renderChips();
        renderAttention(list);
        renderUpcoming(list);
        renderGroups(list);
        $("#expandAll").setAttribute("aria-pressed", String(state.expanded.size >= list.length && list.length > 0));
        $("#tableToggle").setAttribute("aria-pressed", String(state.tableView));
      }

      $("#search").value = state.query;
      $("#search").addEventListener("input", e => { state.query = e.target.value; render(); });

      $("#expandAll").addEventListener("click", () => {
        const list = visible();
        if (state.expanded.size >= list.length && list.length) state.expanded.clear();
        else for (const r of list) state.expanded.add(r.path);
        render();
      });

      $("#tableToggle").addEventListener("click", () => { state.tableView = !state.tableView; render(); });

      /* Theme: auto → light → dark, remembered where the browser allows it. */
      const THEMES = ["auto", "light", "dark"];
      let themeIndex = 0;
      try {
        const saved = localStorage.getItem("orrery-theme");
        if (saved && THEMES.includes(saved)) themeIndex = THEMES.indexOf(saved);
      } catch (_) { /* file:// with site data blocked */ }

      function applyTheme() {
        const t = THEMES[themeIndex];
        if (t === "auto") document.documentElement.removeAttribute("data-theme");
        else document.documentElement.setAttribute("data-theme", t);
        $("#themeToggle").textContent = "Theme: " + t;
        try { localStorage.setItem("orrery-theme", t); } catch (_) {}
      }
      $("#themeToggle").addEventListener("click", () => {
        themeIndex = (themeIndex + 1) % THEMES.length;
        applyTheme();
      });

      document.addEventListener("keydown", e => {
        if (e.key === "/" && document.activeElement !== $("#search")) { e.preventDefault(); $("#search").focus(); }
        if (e.key === "Escape" && document.activeElement === $("#search")) {
          $("#search").value = ""; state.query = ""; render(); $("#search").blur();
        }
      });

      applyTheme();
      renderHeader();
      renderTiles();
      render();

      /* ------------------------------------------------------------------ */
      /* refresh (only when served by the application)                      */
      /* ------------------------------------------------------------------ */

      // Waits for the store to finish whatever it is collecting, then reloads
      // when the report changed. One poller at a time, whoever started it.
      function pollThenReload() {
        if (polling) return;
        polling = true;
        const tick = async () => {
          try {
            const response = await fetch("/api/status", { headers: { accept: "application/json" } });
            const status = await response.json();
            if (status.refreshing) { setTimeout(tick, 2000); return; }
            polling = false;
            if (status.generated_at && status.generated_at !== DATA.generated_at) { location.reload(); return; }
            const header = $("#refresh");
            if (header) {
              header.disabled = false; header.textContent = "Refresh";
              if (status.last_error) header.title = `Last collection failed: ${status.last_error}`;
            }
            for (const b of document.querySelectorAll(".rowbtn[disabled]")) { b.disabled = false; b.textContent = "\u21bb"; }
          } catch (_error) {
            setTimeout(tick, 5000);
          }
        };
        tick();
      }

      async function requestRefresh(body) {
        try {
          await fetch("/refresh", {
            method: "POST",
            headers: { accept: "application/json", "content-type": "application/json", "x-csrf-token": csrf },
            body: JSON.stringify(body || {})
          });
        } catch (_error) { /* the poll reports the outcome */ }
        setTimeout(pollThenReload, 1500);
      }

      if (SERVED) {
        const header = $("#refresh");
        header.addEventListener("click", () => {
          header.disabled = true; header.setAttribute("aria-busy", "true"); header.textContent = "Refreshing\u2026";
          requestRefresh({});
        });
        if (STATUS.refreshing) { header.disabled = true; header.textContent = "Refreshing\u2026"; pollThenReload(); }
      }
    </script>
  </body>
</html>
